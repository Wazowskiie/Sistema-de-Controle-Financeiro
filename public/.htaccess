Options -MultiViews
RewriteEngine On
# Arquivo de /assets que não existe mais responde 404 (antes devolvia a página, causando o erro de "MIME type")
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

# A página principal nunca fica guardada no navegador: sempre pega a versão nova
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
